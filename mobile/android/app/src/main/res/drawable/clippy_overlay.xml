<?xml version="1.0" encoding="utf-8"?>
<!-- Static idle-pose Clippy for the SYSTEM_ALERT_WINDOW overlay (FloatingService).
     Mirrors mobile/src/mascot/Clippy.js's SVG (an actual paperclip, same shape
     language as the app icon), minus the Reanimated eye-tracking/blink/mood
     states — those stay exclusive to the in-app experience. Bob animation is
     applied natively in FloatingService.java. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="72dp"
    android:viewportWidth="80"
    android:viewportHeight="90">

  <!-- halo -->
  <path
      android:pathData="M22,10 a18,5.5 0 1,0 36,0 a18,5.5 0 1,0 -36,0"
      android:strokeColor="#FCD34D"
      android:strokeWidth="3"
      android:fillColor="#00000000" />

  <!-- antenna, connecting down into the paperclip's top hook -->
  <path
      android:pathData="M40,16 L40,30"
      android:strokeColor="#d97706"
      android:strokeWidth="2.4"
      android:strokeLineCap="round"
      android:fillColor="#00000000" />
  <path
      android:pathData="M36.8,14 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
      android:fillColor="#FCD34D" />

  <!-- paperclip body — bent-wire loop, same shape language as the app icon -->
  <path
      android:pathData="M18,74 a22,22 0 0,0 45,0 l0,-42 a14,14 0 0,0 -28,0 l0,39"
      android:strokeColor="#ff9a1f"
      android:strokeWidth="9"
      android:strokeLineCap="round"
      android:fillColor="#00000000" />

  <!-- eye whites -->
  <path
      android:pathData="M14,50 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
      android:fillColor="#ffffff" />
  <path
      android:pathData="M44,50 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
      android:fillColor="#ffffff" />

  <!-- pupils (centered — no eye-tracking in the overlay) -->
  <path
      android:pathData="M19.8,50 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0"
      android:fillColor="#1e1b4b" />
  <path
      android:pathData="M49.8,50 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0"
      android:fillColor="#1e1b4b" />

  <!-- pupil shine -->
  <path
      android:pathData="M20.8,47.6 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0"
      android:fillColor="#ffffff"
      android:fillAlpha="0.85" />
  <path
      android:pathData="M50.8,47.6 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0"
      android:fillColor="#ffffff"
      android:fillAlpha="0.85" />

  <!-- blush -->
  <path
      android:pathData="M9.5,58 a5.5,3 0 1,0 11,0 a5.5,3 0 1,0 -11,0"
      android:fillColor="#f9a8d4"
      android:fillAlpha="0.5" />
  <path
      android:pathData="M57.5,58 a5.5,3 0 1,0 11,0 a5.5,3 0 1,0 -11,0"
      android:fillColor="#f9a8d4"
      android:fillAlpha="0.5" />

  <!-- mouth -->
  <path
      android:pathData="M27,66 Q40,73 53,66"
      android:strokeColor="#ffffff"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeAlpha="0.85"
      android:fillColor="#00000000" />

  <!-- drop shadow -->
  <path
      android:pathData="M19,76 a21,4.5 0 1,0 42,0 a21,4.5 0 1,0 -42,0"
      android:fillColor="#000000"
      android:fillAlpha="0.16" />

</vector>
