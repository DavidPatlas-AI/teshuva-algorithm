<?xml version="1.0" encoding="utf-8"?>
<!-- Sideload-only feed watcher — see CLAUDE.md "Phase 4" before touching this. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="300"
    android:packageNames="com.instagram.android,com.zhiliaoapp.musically,com.twitter.android"
    android:description="@string/feed_watcher_description" />
